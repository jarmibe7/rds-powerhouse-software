<?xml version="1.0" ?>
<sdf version="1.6" xmlns:drake="drake.mit.edu">
  <model name="catapult">
    <static>false</static>

    <!-- Thin base wedge welded to the table by the simulator -->
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0025</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0040</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.14 0.03 0.025</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>1e7</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.003</drake:mesh_resolution_hint>
          <drake:mu_static value="500.0"/>
          <drake:mu_dynamic value="500.0"/>
        </drake:proximity_properties>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.14 0.03 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.45 0.25 0.10 1</ambient>
          <diffuse>0.62 0.34 0.14 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Lever arm: the mesh is a thin plank with a cup at one end -->
    <link name="arm">
      <pose>0 0 0.025 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0025</ixx>
          <iyy>0.0040</iyy>
          <izz>0.0025</izz>
        </inertia>
      </inertial>
      <collision name="arm_collision">
        <geometry>
          <box>
            <size>0.025 0.3 0.01</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>1e7</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.003</drake:mesh_resolution_hint>
          <drake:mu_static value="500.0"/>
          <drake:mu_dynamic value="500.0"/>
        </drake:proximity_properties>
      </collision>
      <visual name="arm_visual">
        <geometry>
          <box>
            <size>0.025 0.3 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Small stop at the end of the arm to keep the projectile in place -->
      <collision name="arm_stop_collision">
        <pose>0 0.135 0.00626 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.03 0.002</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>1e7</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.003</drake:mesh_resolution_hint>
          <drake:mu_static value="500.0"/>
          <drake:mu_dynamic value="500.0"/>
        </drake:proximity_properties>
      </collision>
      <visual name="arm_stop_visual">
        <pose>0 0.135 0.006 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.03 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Projectile kept separate so it can be launched -->
    <link name="projectile">
      <pose>-0.185 0 0.035 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.000008</ixx>
          <iyy>0.000008</iyy>
          <izz>0.000008</izz>
        </inertia>
      </inertial>
      <collision name="proj_col">
        <geometry>
          <box>
            <size>0.015 0.015 0.015</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>1e7</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.003</drake:mesh_resolution_hint>
          <drake:mu_static value="500.0"/>
          <drake:mu_dynamic value="500.0"/>
        </drake:proximity_properties>
      </collision>
      <visual name="proj_vis">
        <geometry>
          <box>
            <size>0.015 0.015 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.1 0.1 1</ambient>
          <diffuse>1.0 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Joint at the midpoint of the lever arm
    <joint name="arm_joint" type="revolute">
      <parent>base</parent>
      <child>arm</child>
      <pose>0 0 0.025 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.25</lower>
          <upper>1.25</upper>
          <effort>0</effort>
        </limit>
        <dynamics>
          <damping>0.0</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint> -->

  </model>
</sdf>
