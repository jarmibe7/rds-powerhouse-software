<?xml version="1.0"?>
<sdf version="1.8" xmlns:drake="drake.mit.edu">
  <model name="weight">
    <link name="weight_body">
      <inertial>
        <mass>5.0</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0010833333333333333</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00425</iyy>
          <iyz>0.0</iyz>
          <izz>0.004083333333333333</izz>
        </inertia>
      </inertial>
      <visual name="weight_body_visual">
        <geometry>
          <mesh>
            <uri>package://finger_description/meshes/weight.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="weight_body_collision">
        <geometry>
          <mesh>
            <uri>package://finger_description/meshes/weight.obj</uri>
          </mesh>
        </geometry>
        <drake:proximity_properties>
          <drake:rigid_hydroelastic/>
          <drake:mu_static value="2.5"/>
          <drake:mu_dynamic value="2.5"/>
        </drake:proximity_properties>
      </collision>
    </link>

