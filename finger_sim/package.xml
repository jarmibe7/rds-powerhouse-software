<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>finger_sim</name>
  <version>0.0.1</version>
  <description>Drake-based simulation of the Powerhouse finger</description>
  <maintainer email="jarmibe7@gmail.com">Jared Berry</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>drake_ros</depend>
  <depend>finger_description</depend>

  <exec_depend>python3-drake</exec_depend>

  <test_depend>pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>