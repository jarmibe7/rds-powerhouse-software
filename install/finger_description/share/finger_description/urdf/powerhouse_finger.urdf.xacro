<?xml version="1.0"?>
<robot name="powerhouse_finger" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:drake="drake.mit.edu">

  <!-- Generated by blender_export_drake.py from /home/jarmibe7/ws_rds/src/rds-powerhouse-software/finger_description/meshes/segment.blend -->

  <!--
    mesh_ext: stl → RViz (default),  gltf → Drake/Meshcat

    4-bar linkage:
      left_bar / right_bar are visual-only passive links.
      PIP-side pins → URDF revolute joints (left/right_bar_joint).
      DIP-side pins → Drake AddFixedConstraint (NOT URDF joints).
      dip_flexion has no mimic — driven by geometric loop closure.
      Offsets are computed from joint_axes.yaml world_origin fields.

    Drake contact:
      Each <collision> carries <drake:proximity_properties>.
      Adjacent links suppressed via <drake:collision_filter_group>.
  -->
  <xacro:arg name="mesh_ext" default="gltf"/>
  <xacro:property name="ext" value="$(arg mesh_ext)"/>

  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>
  <material name="green">
    <color rgba="0 1 0 1"/>
  </material>
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  <material name="purple">
    <color rgba="1 0 1 1"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="yellow">
    <color rgba="1 1 0 1"/>
  </material>

  <!-- Finger base -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://finger_description/meshes/visual/base_link.${ext}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://finger_description/meshes/collision/col_base_link.${ext}"/>
      </geometry>
      <drake:proximity_properties>
        <drake:compliant_hydroelastic/>
        <drake:hydroelastic_modulus value="1e+07"/>
        <drake:hunt_crossley_dissipation value="0.5"/>
        <drake:mu_static value="0.8"/>
        <drake:mu_dynamic value="0.6"/>
      </drake:proximity_properties>
    </collision>
    <inertial>
      <mass value="0.183"/>
      <origin xyz="0.02038 -0.0 0.0975" rpy="0 0 0"/>
      <inertia ixx="0.0002589" ixy="0" ixz="0" iyy="0.0002239" iyz="0" izz="4.004e-05"/>
    </inertial>
  </link>

  <!-- Mcp Splay -->
  <joint name="mcp_splay" type="revolute">
    <parent link="base_link"/>
    <child link="mcp_link"/>
    <origin xyz="0.0195 -0.0 0.0983" rpy="0 0 0"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-0.174533" upper="0.174533" effort="50.0" velocity="3.14"/>
    <dynamics damping="0.001" friction="0.0001"/>
  </joint>

  <!-- Space between MCP splay and flexion -->
  <link name="mcp_link">
    <visual>
      <geometry>
        <mesh filename="package://finger_description/meshes/visual/mcp_link.${ext}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://finger_description/meshes/collision/col_mcp_link.${ext}"/>
      </geometry>
      <drake:proximity_properties>
        <drake:compliant_hydroelastic/>
        <drake:hydroelastic_modulus value="1e+07"/>
        <drake:hunt_crossley_dissipation value="0.5"/>
        <drake:mu_static value="0.8"/>
        <drake:mu_dynamic value="0.6"/>
      </drake:proximity_properties>
    </collision>
    <inertial>
      <mass value="0.04479276"/>
      <origin xyz="0.00073 0.00071 0.00014" rpy="0 0 0"/>
      <inertia ixx="8.781e-06" ixy="0" ixz="0" iyy="9.893e-06" iyz="0" izz="6.671e-06"/>
    </inertial>
  </link>

  <!-- Mcp Flexion -->
  <joint name="mcp_flexion" type="revolute">
    <parent link="mcp_link"/>
    <child link="proximal_phalanx"/>
    <origin xyz="0.013 0.0 -0.0006" rpy="0 0 0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="-0.785" upper="0.785" effort="50.0" velocity="3.14"/>
    <dynamics damping="0.001" friction="0.0001"/>
  </joint>

  <!-- Proximal phalanx (ground link of 4-bar) -->
  <link name="proximal_phalanx">
    <visual>
      <geometry>
        <mesh filename="package://finger_description/meshes/visual/proximal_phalanx.${ext}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://finger_description/meshes/collision/col_proximal_phalanx.${ext}"/>
      </geometry>
      <drake:proximity_properties>
        <drake:compliant_hydroelastic/>
        <drake:hydroelastic_modulus value="1e+07"/>
        <drake:hunt_crossley_dissipation value="0.5"/>
        <drake:mu_static value="0.8"/>
        <drake:mu_dynamic value="0.6"/>
      </drake:proximity_properties>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin xyz="0.03712 0.00024 -0.0019" rpy="0 0 0"/>
      <inertia ixx="1.5e-05" ixy="0" ixz="0" iyy="4.649e-05" iyz="0" izz="4.385e-05"/>
    </inertial>
  </link>

  <!-- Pip Flexion -->
  <joint name="pip_flexion" type="revolute">
    <parent link="proximal_phalanx"/>
    <child link="middle_phalanx"/>
    <origin xyz="0.065 0.0014 0.0004" rpy="0 0 0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="0.0" upper="1.57" effort="50.0" velocity="3.14"/>
    <dynamics damping="0.001" friction="0.0001"/>
  </joint>

  <!-- Middle phalanx — IS the coupler bar of the 4-bar linkage -->
  <link name="middle_phalanx">
    <visual>
      <geometry>
        <mesh filename="package://finger_description/meshes/visual/middle_phalanx.${ext}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://finger_description/meshes/collision/col_middle_phalanx.${ext}"/>
      </geometry>
      <drake:proximity_properties>
        <drake:compliant_hydroelastic/>
        <drake:hydroelastic_modulus value="1e+07"/>
        <drake:hunt_crossley_dissipation value="0.5"/>
        <drake:mu_static value="0.8"/>
        <drake:mu_dynamic value="0.6"/>
      </drake:proximity_properties>
    </collision>
    <inertial>
      <mass value="0.01111115"/>
      <origin xyz="0.01223 0.00192 -0.00048" rpy="0 0 0"/>
      <inertia ixx="5e-06" ixy="0" ixz="0" iyy="5e-06" iyz="0" izz="5e-06"/>
    </inertial>
  </link>

  <!-- Dip Flexion -->
  <joint name="dip_flexion" type="revolute">
    <parent link="middle_phalanx"/>
    <child link="distal_phalanx"/>
    <origin xyz="0.04 0.0019 0.0002" rpy="0 0 0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="0.0" upper="1.57" effort="50.0" velocity="3.14"/>
    <dynamics damping="0.001" friction="0.0001"/>
  </joint>

  <!-- Distal phalanx (driven link of 4-bar) -->
  <link name="distal_phalanx">
    <visual>
      <geometry>
        <mesh filename="package://finger_description/meshes/visual/distal_phalanx.${ext}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://finger_description/meshes/collision/col_distal_phalanx.${ext}"/>
      </geometry>
      <drake:proximity_properties>
        <drake:compliant_hydroelastic/>
        <drake:hydroelastic_modulus value="5e+06"/>
        <drake:hunt_crossley_dissipation value="1.0"/>
        <drake:mu_static value="1.0"/>
        <drake:mu_dynamic value="0.8"/>
      </drake:proximity_properties>
    </collision>
    <inertial>
      <mass value="0.03845096"/>
      <origin xyz="0.00948 -0.00161 0.00018" rpy="0 0 0"/>
      <inertia ixx="5.11e-06" ixy="0" ixz="0" iyy="7.503e-06" iyz="0" izz="7.527e-06"/>
    </inertial>
  </link>

  <!-- Left exterior bar — visual only, no collision, driven by loop closure -->
  <link name="left_bar">
    <visual>
      <geometry>
        <mesh filename="package://finger_description/meshes/visual/left_bar.${ext}"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.00283571"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <inertia ixx="2.878e-08" ixy="0" ixz="0" iyy="3.747e-07" iyz="0" izz="3.53e-07"/>
    </inertial>
  </link>

  <!-- Right exterior bar — visual only, no collision, driven by loop closure -->
  <link name="right_bar">
    <visual>
      <geometry>
        <mesh filename="package://finger_description/meshes/visual/right_bar.${ext}"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.00283571"/>
      <origin xyz="0.01709 0.01322 0.00633" rpy="0 0 0"/>
      <inertia ixx="2.878e-08" ixy="0" ixz="0" iyy="3.747e-07" iyz="0" izz="3.53e-07"/>
    </inertial>
  </link>

  <!-- ═══ 4-bar exterior bar joints (branch off proximal_phalanx) ══ -->
  <!-- Left Bar Joint -->
  <joint name="left_bar_joint" type="revolute">
    <parent link="proximal_phalanx"/>
    <child link="left_bar"/>
    <origin xyz="0.0613 0.0138 -0.0091" rpy="0 0 0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="0.0" upper="1.57" effort="0.0" velocity="3.14"/>
    <dynamics damping="0.001" friction="0.0001"/>
  </joint>

  <!-- Right Bar Joint -->
  <joint name="right_bar_joint" type="revolute">
    <parent link="proximal_phalanx"/>
    <child link="right_bar"/>
    <origin xyz="0.0613 -0.0121 -0.0091" rpy="0 0 0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="0.0" upper="1.57" effort="0.0" velocity="3.14"/>
    <dynamics damping="0.001" friction="0.0001"/>
  </joint>

  <!-- ═══ Drake collision filter groups ═══════════════════════════════ -->
  <drake:collision_filter_group name="base_and_mcp">
    <drake:member link="base_link"/>
    <drake:member link="mcp_link"/>
    <drake:ignored_collision_filter_group name="base_and_mcp"/>
  </drake:collision_filter_group>

  <drake:collision_filter_group name="mcp_and_proximal">
    <drake:member link="mcp_link"/>
    <drake:member link="proximal_phalanx"/>
    <drake:ignored_collision_filter_group name="mcp_and_proximal"/>
  </drake:collision_filter_group>

  <drake:collision_filter_group name="proximal_and_middle">
    <drake:member link="proximal_phalanx"/>
    <drake:member link="middle_phalanx"/>
    <drake:ignored_collision_filter_group name="proximal_and_middle"/>
  </drake:collision_filter_group>

  <drake:collision_filter_group name="middle_and_distal">
    <drake:member link="middle_phalanx"/>
    <drake:member link="distal_phalanx"/>
    <drake:ignored_collision_filter_group name="middle_and_distal"/>
  </drake:collision_filter_group>

  <drake:collision_filter_group name="base_and_proximal">
    <drake:member link="base_link"/>
    <drake:member link="proximal_phalanx"/>
    <drake:ignored_collision_filter_group name="base_and_proximal"/>
  </drake:collision_filter_group>

  <drake:collision_filter_group name="proximal_and_bars">
    <drake:member link="proximal_phalanx"/>
    <drake:member link="left_bar"/>
    <drake:member link="right_bar"/>
    <drake:ignored_collision_filter_group name="proximal_and_bars"/>
  </drake:collision_filter_group>

  <drake:collision_filter_group name="bars_and_middle">
    <drake:member link="left_bar"/>
    <drake:member link="right_bar"/>
    <drake:member link="middle_phalanx"/>
    <drake:ignored_collision_filter_group name="bars_and_middle"/>
  </drake:collision_filter_group>

  <drake:collision_filter_group name="bars_and_distal">
    <drake:member link="left_bar"/>
    <drake:member link="right_bar"/>
    <drake:member link="distal_phalanx"/>
    <drake:ignored_collision_filter_group name="bars_and_distal"/>
  </drake:collision_filter_group>

  <drake:collision_filter_group name="bars_mutual">
    <drake:member link="left_bar"/>
    <drake:member link="right_bar"/>
    <drake:ignored_collision_filter_group name="bars_mutual"/>
  </drake:collision_filter_group>

</robot>